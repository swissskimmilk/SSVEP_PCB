    "PD": {
      "doc": {
        "title": "photodiode",
        "summary": "Screen-sync input. A BPW34 photodiode sits on the end of a twisted-pair cable (it is not on this board) plugged into J1, a 2-pin PicoBlade: pin 1 to the cathode, pin 2 to the anode. R1/C1 feed the reverse bias from the analog rail through a filter, so cable pickup cannot reach +3.3V. The photocurrent flows through R2 (1k, cable isolation) into R3 (load) with C2, a ~1 ms low-pass that smooths monitor backlight PWM. PD_OUT goes to a spare ADS131M08 channel, measured against GND, so every flash is sampled at the same instant as the EEG. Keep the white-patch level under the ADC's +1.2 V full scale: lower R3 if the screen is bright.",
        "components": [
          {
            "ref": "J1",
            "mpn": "0530470210",
            "value": "PHOTODIODE",
            "why": "photodiode cable: pin 1 = BPW34 cathode, pin 2 = BPW34 anode"
          },
          {
            "ref": "R1",
            "symbol": "R",
            "value": "1k",
            "why": "bias feed filter",
            "footprint": "Resistor_SMD:R_0805_2012Metric_Pad1.20x1.40mm_HandSolder",
            "mpn": "RC0805FR-071KL",
            "datasheet": "https://yageogroup.com/content/Resource%20Library/Datasheet/PYU-RC_GROUP_51_ROHS_L.pdf"
          },
