    "MCU": {
      "file": "mcu_power.circuit.json"
    },
    "PD": {
      "file": "photodiode.circuit.json"
    },
    "ANALOG": {
      "file": "partner/analog_planned.circuit.json"
    }
  },
  "components": [],
  "nets": {
    "+3.3V": {
      "kind": "power",
      "voltage": 3.3,
      "pins": [
        "MCU:+3.3V",
        "PD:+3.3V",
        "ANALOG:+3.3V"
      ]
    },
    "GND": {
      "kind": "ground",
      "pins": [
        "MCU:GND",
        "PD:GND",
        "ANALOG:GND"
      ]
    },
